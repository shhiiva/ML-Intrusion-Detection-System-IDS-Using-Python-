# ============================================================
# 1. DATA LOADING AND PREPROCESSING
# ============================================================

def load_data():

    train_path = r"C:/Users/M01101189/Downloads/KDDTrain.csv"
    test_path  = r"C:/Users/M01101189/Downloads/KDDTest.csv"

    train_df = pd.read_csv(train_path)
    test_df  = pd.read_csv(test_path)

    original_label_col = train_df.columns[-1]

    train_df["binary_target"] = train_df[original_label_col].apply(
        lambda x: 0 if str(x).strip().lower() == "normal" else 1
    )
    test_df["binary_target"] = test_df[original_label_col].apply(
        lambda x: 0 if str(x).strip().lower() == "normal" else 1
    )

    X_train = train_df.drop(columns=[original_label_col, "binary_target"])
    X_test  = test_df.drop(columns=[original_label_col, "binary_target"])

    y_train = train_df["binary_target"].values
    y_test  = test_df["binary_target"].values

    noise_ratio = 0.02
    num_noisy = int(len(y_train) * noise_ratio)
    noisy_idx = np.random.choice(len(y_train), num_noisy, replace=False)
    y_train[noisy_idx] = 1 - y_train[noisy_idx]

    categorical_cols = X_train.select_dtypes(include="object").columns
    for col in categorical_cols:
        encoder = LabelEncoder()
        combined = pd.concat([X_train[col], X_test[col]])
        encoder.fit(combined)
        X_train[col] = encoder.transform(X_train[col])
        X_test[col]  = encoder.transform(X_test[col])

    scaler = StandardScaler()
    X_train = scaler.fit_transform(X_train).astype(np.float32)
    X_test  = scaler.transform(X_test).astype(np.float32)

    np.save("sample_input.npy", X_test[0])

    print("[DATA] Training Samples:", X_train.shape[0])
    print("[DATA] Test Samples    :", X_test.shape[0])

    return X_train, y_train, X_test, y_test, train_df, test_df, original_label_col


